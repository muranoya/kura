{
  "manifest_version": 3,
  "name": "kura",
  "version": "0.4.0",
  "description": "サーバ不要のパスワードマネージャー。暗号化されたデータはあなた自身のS3互換ストレージに保存。サブスクなし、ベンダーロックインなし。",

  "permissions": ["storage", "alarms", "clipboardWrite", "clipboardRead", "tabs", "activeTab"],

  "host_permissions": ["<all_urls>"],

  "action": {
    "default_title": "kura",
    "default_icon": {
      "16": "icons/locked-16.png",
      "48": "icons/locked-48.png",
      "128": "icons/locked-128.png"
    }
  },

  "sidebar_action": {
    "default_title": "kura",
    "default_panel": "src/popup/index.html",
    "default_icon": {
      "16": "icons/locked-16.png",
      "48": "icons/locked-48.png",
      "128": "icons/locked-128.png"
    },
    "open_at_install": false
  },

  "background": {
    "scripts": ["src/background/index.ts"],
    "type": "module"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "wasm/wasm_bridge_bg.wasm",
        "src/content/dropdown.css",
        "src/content/capture.css",
        "src/content/totp-qr-scan.css",
        "src/content/picker.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/main.ts"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/webauthn-bridge.ts"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "kura-pm@meshpeak.net",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
