import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon, IconButton } from "../widgets.slint";
import { Errors, Nav, Page, SyncState } from "../state.slint";

export global EntryTypes {
    // フィルター用（先頭は「すべて」）。Rust 側の ENTRY_TYPES と同じ並び
    out property <[string]> filter-labels: ["すべて", "ログイン", "銀行口座", "SSHキー", "セキュアノート", "クレジットカード", "パスワード", "ソフトウェアライセンス"];
    out property <[string]> sort-labels: ["作成日（新しい順）", "作成日（古い順）", "更新日（新しい順）", "更新日（古い順）", "名前（A → Z）", "名前（Z → A）"];

    public pure function icon(entry-type: string) -> image {
        if entry-type == "bank" {
            return Icons.building-2;
        }
        if entry-type == "ssh_key" {
            return Icons.terminal;
        }
        if entry-type == "secure_note" {
            return Icons.file-text;
        }
        if entry-type == "credit_card" {
            return Icons.credit-card;
        }
        if entry-type == "password" {
            return Icons.lock;
        }
        if entry-type == "software_license" {
            return Icons.scroll-text;
        }
        return Icons.key-round;
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> small: false;
    callback clicked();
    height: small ? 28px : 40px;
    border-radius: Theme.radius;
    background: active ? Theme.accent : touch.has-hover ? Theme.bg-elevated : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: root.small ? 8px : 12px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: root.small ? 12px : 18px;
            color: root.active ? #ffffff : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: root.small ? Theme.text-xs : Theme.text-sm;
            font-weight: 500;
            color: root.active ? #ffffff : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    width: 220px;
    background: Theme.bg-sidebar;
    VerticalLayout {
        // ブランド
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 24px;
            padding-bottom: 24px;
            spacing: 4px;
            Text {
                text: "kura";
                font-size: Theme.text-2xl;
                font-weight: 700;
                color: Theme.text-primary;
            }

            Text {
                text: "パスワードマネージャー";
                font-size: Theme.text-xs;
                color: Theme.text-muted;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        ScrollView {
            vertical-stretch: 1;
            content-height: nav.preferred-height;
            nav := VerticalLayout {
                width: parent.visible-width;
                padding: 8px;
                padding-top: 16px;
                spacing: 8px;
                NavButton {
                    text: "全てのアイテム";
                    icon: Icons.key-round;
                    active: Nav.page == Page.entries || Nav.page == Page.entry-create || Nav.page == Page.entry-edit;
                    clicked => {
                        Nav.navigate(Page.entries);
                    }
                }

                NavButton {
                    text: "お気に入り";
                    icon: Icons.star;
                    active: Nav.page == Page.favorites;
                    clicked => {
                        Nav.navigate(Page.favorites);
                    }
                }

                NavButton {
                    text: "ラベル";
                    icon: Icons.tags;
                    active: Nav.page == Page.labels;
                    clicked => {
                        Nav.navigate(Page.labels);
                    }
                }

                if Nav.labels.length > 0: VerticalLayout {
                    padding-left: 16px;
                    spacing: 2px;
                    for label in Nav.labels: NavButton {
                        small: true;
                        text: label.name;
                        icon: Icons.tag;
                        active: Nav.page == Page.label-entries && Nav.label-id == label.id;
                        clicked => {
                            Nav.open-label(label.id, label.name);
                        }
                    }
                }

                NavButton {
                    text: "パスワード生成";
                    icon: Icons.wand-2;
                    active: Nav.page == Page.password-generator;
                    clicked => {
                        Nav.navigate(Page.password-generator);
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        VerticalLayout {
            padding: 8px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 8px;
            NavButton {
                text: "ゴミ箱";
                icon: Icons.trash-2;
                active: Nav.page == Page.trash;
                clicked => {
                    Nav.navigate(Page.trash);
                }
            }

            NavButton {
                text: "設定";
                icon: Icons.settings;
                active: Nav.page == Page.settings;
                clicked => {
                    Nav.navigate(Page.settings);
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
}

// 画面上部のエラーバー（最新のエラーのみ表示し、件数を添える）
export component ErrorBar inherits Rectangle {
    visible: Errors.count > 0;
    height: Errors.count > 0 ? 36px : 0px;
    background: #fef2f2;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.alert-triangle;
            color: Theme.danger;
        }

        Text {
            horizontal-stretch: 1;
            text: Errors.latest;
            color: Theme.danger;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            overflow: elide;
        }

        if Errors.count > 1: Text {
            text: "+" + (Errors.count - 1);
            color: Theme.danger;
            font-size: Theme.text-xs;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.x;
            color: Theme.danger;
            hover-color: Theme.danger;
            clicked => {
                Errors.dismiss();
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.danger;
    }
}

export component SyncHeaderActions inherits HorizontalLayout {
    spacing: 6px;
    visible: SyncState.has-config;
    if SyncState.has-config && SyncState.last-sync != "": Text {
        text: SyncState.last-sync;
        font-size: Theme.text-xs;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    if SyncState.has-config: IconButton {
        y: (parent.height - self.height) / 2;
        icon: SyncState.syncing ? Icons.loader-2 : Icons.refresh-cw;
        enabled: !SyncState.syncing;
        tooltip: "今すぐ同期";
        clicked => {
            SyncState.sync-now();
        }
    }
}

// メイン画面上部の固定ヘッダー（タイトル + 同期ボタン）
export component ScreenHeader inherits Rectangle {
    in property <string> title;
    height: 44px;
    background: Theme.bg-surface;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: Theme.text-sm;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }

        SyncHeaderActions { }
    }
}

export component HorizontalDivider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component VerticalDivider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

// 種別フィルター + 検索 + 並び替え（旧 EntryFilterBar）
export component FilterBar inherits HorizontalLayout {
    in-out property <int> type-index;
    in-out property <int> sort-index;
    in-out property <string> search;
    callback changed();
    spacing: 8px;
    ComboBox {
        width: 150px;
        model: EntryTypes.filter-labels;
        current-index <=> root.type-index;
        selected => {
            root.changed();
        }
    }

    Rectangle {
        horizontal-stretch: 1;
        search-edit := LineEdit {
            width: 100%;
            text <=> root.search;
            placeholder-text: "名前、メモ、カスタムフィールド名で検索...";
            edited => {
                root.changed();
            }
        }

        if root.search != "": IconButton {
            x: parent.width - self.width - 8px;
            icon: Icons.x;
            tooltip: "検索をクリア";
            clicked => {
                root.search = "";
                root.changed();
            }
        }
    }

    sort-button := Rectangle {
        width: 36px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        background: sort-touch.has-hover ? Theme.bg-elevated : Theme.bg-surface;
        Icon {
            source: Icons.arrow-up-down;
        }

        sort-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                sort-popup.show();
            }
        }
    }

    @children

    sort-popup := PopupWindow {
        x: sort-button.x + sort-button.width - 220px;
        y: sort-button.y + sort-button.height + 4px;
        width: 220px;
        Rectangle {
            background: Theme.bg-surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000026;
            VerticalLayout {
                padding: 4px;
                for label[i] in EntryTypes.sort-labels: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: item-touch.has-hover ? Theme.bg-elevated : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            if i == root.sort-index: Icon {
                                source: Icons.check;
                                size: 14px;
                                color: Theme.accent;
                            }
                        }

                        Text {
                            text: label;
                            font-size: Theme.text-sm;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    item-touch := TouchArea {
                        clicked => {
                            root.sort-index = i;
                            root.changed();
                        }
                    }
                }
            }
        }
    }
}
