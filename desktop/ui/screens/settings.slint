import { ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppButton, Card, CodeBlock, Dialog, DialogFooter, ErrorBanner, FieldLabel, Icon, PasswordInput, ScrollPage } from "../widgets.slint";
import { Confirm, Settings, Util } from "../state.slint";
import { HorizontalDivider, ScreenHeader } from "layout.slint";

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Theme.text-sm;
            color: Theme.text-primary;
        }

        Text {
            text: root.description;
            font-size: Theme.text-xs;
            color: Theme.text-muted;
        }
    }

    @children
}

component InfoItem inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: Theme.text-xs;
        font-weight: 500;
        color: Theme.text-secondary;
    }

    Text {
        text: root.value;
        font-family: Theme.mono;
        font-size: Theme.text-sm;
        color: Theme.text-primary;
        wrap: char-wrap;
    }
}

export component SettingsScreen inherits Rectangle {
    background: Theme.bg-base;
    VerticalLayout {
        ScreenHeader {
            title: "設定";
        }

        HorizontalDivider { }

        ScrollPage {
            vertical-stretch: 1;
            max-content-width: 100000px;
            pad: 12px;
            spacing: 12px;
            Card {
                title: "一般";
                SettingRow {
                    title: "自動ロック";
                    description: "ウィンドウのフォーカスが外れてからの時間";
                    ComboBox {
                        width: 120px;
                        model: ["無効", "1分", "3分", "5分", "10分", "15分", "30分", "60分"];
                        current-index <=> Settings.autolock-index;
                        selected => {
                            Settings.settings-changed();
                        }
                    }
                }

                SettingRow {
                    title: "クリップボード自動クリア";
                    description: "コピー後の自動クリアまでの時間";
                    ComboBox {
                        width: 120px;
                        model: ["無効", "30秒", "1分", "2分"];
                        current-index <=> Settings.clipboard-index;
                        selected => {
                            Settings.settings-changed();
                        }
                    }
                }
            }

            Card {
                title: "セキュリティ";
                AppButton {
                    text: "マスターパスワード変更";
                    variant: "secondary";
                    clicked => {
                        Settings.dialog-error = "";
                        Settings.dialog = "change-password";
                    }
                }

                AppButton {
                    text: "DEK更新";
                    variant: "secondary";
                    clicked => {
                        Settings.dialog-error = "";
                        Settings.dialog = "rotate-dek";
                    }
                }

                AppButton {
                    text: "リカバリーキー再生成";
                    variant: "secondary";
                    clicked => {
                        Settings.dialog-error = "";
                        Settings.dialog = "regenerate-recovery";
                    }
                }

                AppButton {
                    text: "ログアウト";
                    variant: "destructive";
                    clicked => {
                        Confirm.action = "logout-settings";
                        Confirm.title = "ログアウト";
                        Confirm.description = "ログアウトするとローカルキャッシュとS3設定がクリアされます。再度ログインには設定の再入力が必要になります。";
                        Confirm.confirm-text = "ログアウト";
                        Confirm.dangerous = true;
                        Confirm.open = true;
                    }
                }
            }

            Card {
                title: "データ";
                AppButton {
                    text: Settings.exporting ? "エクスポート中..." : "Bitwarden形式でエクスポート";
                    variant: "secondary";
                    enabled: !Settings.exporting;
                    clicked => {
                        Settings.reauth-requested("export");
                    }
                }
            }

            Card {
                title: "ストレージ設定";
                if !Settings.has-storage: Text {
                    text: "ストレージ設定が見つかりません";
                    font-size: Theme.text-sm;
                    color: Theme.text-muted;
                }
                if Settings.has-storage: VerticalLayout {
                    spacing: 12px;
                    InfoItem {
                        label: "バケット";
                        value: Settings.bucket != "" ? Settings.bucket : "N/A";
                    }

                    InfoItem {
                        label: "リージョン";
                        value: Settings.region != "" ? Settings.region : "N/A";
                    }

                    InfoItem {
                        label: "ファイルパス";
                        value: Settings.key;
                    }

                    if Settings.endpoint != "": InfoItem {
                        label: "エンドポイント";
                        value: Settings.endpoint;
                    }
                    AppButton {
                        text: "設定を別端末に転送";
                        variant: "secondary";
                        has-icon: true;
                        icon: Icons.smartphone;
                        clicked => {
                            Settings.reauth-requested("transfer");
                        }
                    }
                }
            }

            Card {
                title: "このアプリについて";
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "バージョン";
                        font-size: Theme.text-sm;
                        color: Theme.text-muted;
                    }

                    Text {
                        text: Settings.version;
                        font-size: Theme.text-sm;
                        color: Theme.text-primary;
                    }
                }

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "リポジトリ";
                        font-size: Theme.text-sm;
                        color: Theme.text-muted;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "GitHub";
                            font-size: Theme.text-sm;
                            color: Theme.accent;
                            gh-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Util.open-url("https://github.com/muranoya/kura");
                                }
                            }
                        }

                        Icon {
                            y: (parent.height - self.height) / 2;
                            source: Icons.external-link;
                            size: 12px;
                            color: Theme.accent;
                        }
                    }
                }
            }
        }
    }
}

component DialogError inherits ErrorBanner {
    text: Settings.dialog-error;
}

component CancelButton inherits AppButton {
    text: "キャンセル";
    variant: "secondary";
    enabled: !Settings.dialog-loading;
    clicked => {
        Settings.close-dialog();
    }
}

component PasswordField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted();
    spacing: 6px;
    FieldLabel {
        text: root.label;
    }

    PasswordInput {
        text <=> root.text;
        placeholder-text: root.placeholder;
        enabled: !Settings.dialog-loading;
        accepted => {
            root.accepted();
        }
    }
}

// 設定画面のダイアログ群（Settings.dialog で切り替える）
export component SettingsDialogs inherits Rectangle {
    private property <bool> copied;
    if Settings.dialog == "change-password": Dialog {
        title: "マスターパスワード変更";
        description: "新しいマスターパスワードを設定します。現在のパスワードで認証が必要です。 変更後、他のセットアップ済み端末では新しいマスターパスワードでの再ログインが必要になります。";
        dismissable: !Settings.dialog-loading;
        dismissed => {
            Settings.close-dialog();
        }
        PasswordField {
            label: "現在のパスワード";
            placeholder: "現在のパスワード";
            text <=> Settings.pw-old;
        }

        PasswordField {
            label: "新しいパスワード";
            placeholder: "新しいパスワード";
            text <=> Settings.pw-new;
        }

        PasswordField {
            label: "新しいパスワード（確認）";
            placeholder: "新しいパスワード（確認）";
            text <=> Settings.pw-confirm;
            accepted => {
                Settings.change-password();
            }
        }

        if Settings.dialog-error != "": DialogError { }

        DialogFooter {
            CancelButton { }

            AppButton {
                text: Settings.dialog-loading ? "変更中..." : "変更";
                enabled: !Settings.dialog-loading;
                clicked => {
                    Settings.change-password();
                }
            }
        }
    }
    if Settings.dialog == "rotate-dek": Dialog {
        title: "DEK更新";
        description: "データ暗号化キーを新しく生成します。マスターパスワードで認証が必要です。 同時にリカバリーキーも更新されます。";
        dismissable: !Settings.dialog-loading;
        dismissed => {
            Settings.close-dialog();
        }
        PasswordField {
            label: "マスターパスワード";
            placeholder: "マスターパスワード";
            text <=> Settings.pw-old;
            accepted => {
                Settings.rotate-dek();
            }
        }

        if Settings.dialog-error != "": DialogError { }

        DialogFooter {
            CancelButton { }

            AppButton {
                text: Settings.dialog-loading ? "更新中..." : "更新";
                enabled: !Settings.dialog-loading;
                clicked => {
                    Settings.rotate-dek();
                }
            }
        }
    }
    if Settings.dialog == "regenerate-recovery": Dialog {
        title: "リカバリーキー再生成";
        description: "新しいリカバリーキーを生成します。マスターパスワードで認証が必要です。";
        dismissable: !Settings.dialog-loading;
        dismissed => {
            Settings.close-dialog();
        }
        PasswordField {
            label: "マスターパスワード";
            placeholder: "マスターパスワード";
            text <=> Settings.pw-old;
            accepted => {
                Settings.regenerate-recovery();
            }
        }

        if Settings.dialog-error != "": DialogError { }

        DialogFooter {
            CancelButton { }

            AppButton {
                text: Settings.dialog-loading ? "生成中..." : "生成";
                enabled: !Settings.dialog-loading;
                clicked => {
                    Settings.regenerate-recovery();
                }
            }
        }
    }
    if Settings.dialog == "reauth": Dialog {
        title: "マスターパスワードの確認";
        description: "機密情報を外部に書き出すため、マスターパスワードを再入力してください。";
        dismissable: !Settings.dialog-loading;
        dismissed => {
            Settings.close-dialog();
        }
        PasswordField {
            label: "マスターパスワード";
            placeholder: "マスターパスワード";
            text <=> Settings.pw-old;
            accepted => {
                if Settings.pw-old != "" {
                    Settings.reauth-submit();
                }
            }
        }

        if Settings.dialog-error != "": DialogError { }

        DialogFooter {
            CancelButton { }

            AppButton {
                text: Settings.dialog-loading ? "確認中..." : "確認";
                enabled: !Settings.dialog-loading && Settings.pw-old != "";
                clicked => {
                    Settings.reauth-submit();
                }
            }
        }
    }
    if Settings.dialog == "transfer": Dialog {
        title: "設定を別端末に転送";
        description: "転送パスワードで暗号化した転送コードを生成します。別の端末のセットアップ時にこのコードと転送パスワードを入力してください。";
        dialog-width: 520px;
        dismissable: !Settings.dialog-loading;
        dismissed => {
            Settings.close-dialog();
        }
        if Settings.transfer-code == "": PasswordField {
            label: "転送パスワード";
            placeholder: "受信側に共有するパスワードを設定";
            text <=> Settings.pw-old;
            accepted => {
                if Settings.pw-old != "" {
                    Settings.generate-transfer();
                }
            }
        }
        if Settings.transfer-code == "" && Settings.dialog-error != "": DialogError { }
        if Settings.transfer-code == "": DialogFooter {
            CancelButton { }

            AppButton {
                text: Settings.dialog-loading ? "生成中..." : "転送コードを生成";
                enabled: !Settings.dialog-loading && Settings.pw-old != "";
                clicked => {
                    Settings.generate-transfer();
                }
            }
        }
        if Settings.transfer-code != "": Rectangle {
            height: 232px;
            background: #ffffff;
            border-radius: 4px;
            Image {
                width: 200px;
                height: 200px;
                source: Settings.transfer-qr;
                image-rendering: pixelated;
            }
        }
        if Settings.transfer-code != "": CodeBlock {
            text: Settings.transfer-code;
            font-size: Theme.text-xs;
        }
        if Settings.transfer-code != "": AppButton {
            text: root.copied ? "コピーしました" : "転送コードをコピー";
            variant: "secondary";
            has-icon: true;
            icon: root.copied ? Icons.check : Icons.copy;
            clicked => {
                Util.copy(Settings.transfer-code);
                root.copied = true;
            }
        }
        if Settings.transfer-code != "": DialogFooter {
            AppButton {
                text: "閉じる";
                clicked => {
                    Settings.close-dialog();
                }
            }
        }
    }
    if Settings.dialog == "recovery-key": Dialog {
        title: "新しいリカバリーキー";
        description: "新しいリカバリーキーが生成されました。安全な場所に保管してください。 マスターパスワードを忘れた場合に使用できます。";
        dismissed => {
            Settings.close-dialog();
        }
        CodeBlock {
            text: Settings.new-recovery-key;
        }

        AppButton {
            text: root.copied ? "コピーしました" : "コピー";
            variant: "secondary";
            has-icon: true;
            icon: root.copied ? Icons.check : Icons.copy;
            clicked => {
                Util.copy(Settings.new-recovery-key);
                root.copied = true;
            }
        }

        DialogFooter {
            AppButton {
                text: "保管しました";
                clicked => {
                    Settings.close-dialog();
                }
            }
        }
    }
    Timer {
        interval: 2s;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }
}

