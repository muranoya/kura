// 旧 React 版 index.css のカラートークンを移植したもの（ライトテーマのみ）
export global Theme {
    // 背景
    out property <color> bg-base: #f5f6f8;
    out property <color> bg-surface: #ffffff;
    out property <color> bg-elevated: #ebedf2;
    out property <color> bg-sidebar: #eff0f3;
    // テキスト
    out property <color> text-primary: #111827;
    out property <color> text-secondary: #4b5563;
    out property <color> text-muted: #9ca3af;
    // アクセント（インディゴ: 信頼感）
    out property <color> accent: #6366f1;
    out property <color> accent-hover: #4f52d1;
    out property <color> accent-subtle: #eef2ff;
    out property <color> accent-soft: #6366f11a;
    // ボーダー
    out property <color> border: #e2e4eb;
    out property <color> border-strong: #c8ccd8;
    // セマンティック
    out property <color> danger: #ef4444;
    out property <color> danger-soft: #ef44441a;
    out property <color> danger-border: #ef444433;
    out property <color> success: #22c55e;
    out property <color> warning: #d97706;

    out property <length> text-xs: 12px;
    out property <length> text-sm: 14px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 18px;
    out property <length> text-xl: 20px;
    out property <length> text-2xl: 24px;
    out property <length> radius: 6px;
    out property <string> mono: "JetBrains Mono";
}
